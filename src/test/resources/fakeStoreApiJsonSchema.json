{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Products schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "number" },
      "title": { "type": "string" },
      "price": { "type": "number" },
      "description": { "type": "string" },
      "category": { "type": "string" },
      "image": { "type": "string" },
      "rating": {
        "type": "object",
        "properties": {
          "rate": { "type": "number" },
          "count": { "type": "number" }
        },
        "required": ["rate", "count"]
      }
    },
    "required": [
      "id",
      "title",
      "price",
      "description",
      "category",
      "image",
      "rating"
    ]
  }
}
